# Local go.mod overrides for this image, applied at build time by go-mod-replacer
# (see Dockerfile). Example: -replace example.com/module=example.com/module@v1.2.3
#
# Prefer the global policy: add broadly-applicable CVE bumps to global_overrides.json
# in rancher/image-build-base. Keep an entry here only if it's specific to this repo.

# golang.org/x/sys: CVE-2026-39824 (net/windows integer overflow in NewNTUnicodeString).
# Drop once upstream requires golang.org/x/sys >= v0.47.0.
-replace golang.org/x/sys=golang.org/x/sys@v0.47.0
# golang.org/x/text: CVE-2026-56852 (infinite loop on invalid input), CVE-2026-56851 (x/text/secure/precis panic).
# Drop once upstream requires golang.org/x/text >= v0.41.0.
-replace golang.org/x/text=golang.org/x/text@v0.41.0
